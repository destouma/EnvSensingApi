# See https://docs.docker.com/engine/reference/builder/#dockerignore-file for more about ignoring files.

# Ignore git directory.
/.git/
/.gitignore

# Ignore bundler config.
/.bundle

# Ignore all environment files (secrets are injected at runtime, never baked into the image).
/.env*

# TLS keys (bin/generate-lan-cert) are mounted into nginx at runtime, never copied into images.
/docker/web/ca/
/docker/web/certs/

# Ignore all default key files.
/config/master.key
/config/credentials/*.key

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore uploaded files and local tooling.
/storage/*
/node_modules/
/.idea/
/postman/
/jmeter.log

# Ignore precompiled assets; they are built inside the image.
/public/assets

# Ignore CI service files.
/.github

# Ignore Docker-related files
/.dockerignore
/docker-compose.yml
