# Copy to .env and fill in. Never commit .env.

# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=

# HTTP Basic credentials for /admin and /api-docs (access is denied in production when unset)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Postgres superuser (maintenance only) and the application's own role. Generate with: openssl rand -hex 24
# Only read when the database volume is first created; see README to change them afterwards.
POSTGRES_PASSWORD=
DATABASE_PASSWORD=

# Host names / IPs clients use to reach the server, comma separated (same as bin/generate-lan-cert).
# Requests with another Host header are rejected. Leave empty to accept any host.
APP_HOSTS=

# Published ports (defaults 8080 and 8443). HTTP only redirects to HTTPS.
# HTTP_PORT=8080
# HTTPS_PORT=8443
